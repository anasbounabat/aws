## App
NUXT_PUBLIC_APP_NAME="Trello Clone"

## Auth
JWT_SECRET="change-me-in-prod"
JWT_EXPIRES_IN_SECONDS="604800" # 7 days

## Database (RDS PostgreSQL)
# Use your RDS endpoint, eg:
# postgres://USER:PASSWORD@your-rds-endpoint.eu-west-1.rds.amazonaws.com:5432/dbname?sslmode=require
DATABASE_URL="postgres://user:pass@host:5432/dbname?sslmode=require"

## AWS (S3 presigned upload)
AWS_REGION="eu-west-1"
S3_BUCKET="your-bucket-name"

# Local dev can use static credentials; on Lambda prefer IAM role (omit these in prod)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

