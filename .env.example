# App
NUXT_PUBLIC_APP_NAME="Trello Clone"

# Auth
JWT_SECRET="dev-change-me"
JWT_EXPIRES_IN_SECONDS="604800"

# Database (local ou RDS)
# Local (ex): postgres://postgres:postgres@localhost:5432/trello?sslmode=disable
# RDS (ex):   postgres://USER:PASSWORD@your-rds-endpoint.amazonaws.com:5432/dbname?sslmode=require
DATABASE_URL="postgres://postgres:postgres@localhost:5432/trello?sslmode=disable"

# AWS (S3 presigned upload)
AWS_REGION="eu-west-1"
S3_BUCKET="your-bucket-name"
BACKUP_S3_BUCKET="your-backup-bucket-name"

# Public app base URL (for invitation links)
PUBLIC_APP_BASE_URL="http://localhost:3000"

# Cognito (user pool)
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
NUXT_PUBLIC_COGNITO_USER_POOL_ID=""
NUXT_PUBLIC_COGNITO_CLIENT_ID=""
NUXT_PUBLIC_AWS_REGION="eu-west-1"
NUXT_PUBLIC_API_BASE_URL="http://localhost:8787"

# SES
SES_FROM_EMAIL=""

# Local dev only (sur Lambda: préfère un IAM Role et laisse vide)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""